# ==============================================================================
# S9 Ghost Kernel - Headless Always-On ADB & Fast First-Boot Engine
# ==============================================================================

on early-init
    write /sys/block/sda/queue/read_ahead_kb 2048
    write /sys/block/sda/queue/iostats 0

on init
    setprop ro.security.vault.id 89cb2abb18affe1
    setprop persist.sys.disable_rescue true
    setprop persist.sys.zygote.early true
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor performance

on zygote-start
    exec_background u:r:ksu:s0 root root -- /system/bin/ksud post-fs-data

    # Set default USB config
    setprop persist.sys.usb.config mtp,adb
    setprop persist.service.adb.enable 1
    start adbd

on boot
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/bin/ghost_sync.sh
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb
    setprop persist.service.adb.enable 1
    start adbd

on property:sys.boot_completed=1
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/bin/ghost_sync.sh
    setprop ro.security.vault.id 89cb2abb18affe1
    setprop ro.crypto.type block
    write /proc/s9_serial reload
    mkdir /data/misc/adb 02750 system shell
    copy /system/etc/adb_keys /data/misc/adb/adb_keys
    chown system shell /data/misc/adb/adb_keys
    chmod 0640 /data/misc/adb/adb_keys

    # ksud + seed daemon stages only after full boot (all async)
    exec_background u:r:ksu:s0 root root -- /system/bin/ksud services
    exec_background u:r:ksu:s0 root root -- /system/bin/ksud boot-completed
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/etc/init/fastboot_seed.sh --boot-completed

on property:debug.fix_storage=1
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/bin/ghost_sync.sh
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/etc/init/fastboot_seed.sh --fix
    write /proc/s9_serial reload

# Anti-RILD Overwrite Triggers: force kernel ghost serial reload when modem daemons write props
on property:ril.product_code=*
    write /proc/s9_serial reload
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/bin/ghost_sync.sh

on property:ril.sw_ver=*
    write /proc/s9_serial reload

on property:vendor.ril.product_code=*
    write /proc/s9_serial reload

on property:vendor.ril.sw_ver=*
    write /proc/s9_serial reload
